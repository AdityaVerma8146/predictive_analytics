{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/server.js"
    },
    {
      "src": "/_vercel/(.*)",
      "dest": "/_vercel/$1"
    },
    {
      "src": "/(css|js)/(.*)",
      "dest": "public/$1/$2"
    },
    {
      "src": "/(favicon\\.ico|index\\.html)",
      "dest": "public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
